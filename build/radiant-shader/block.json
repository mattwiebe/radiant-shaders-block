{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wp-radiant-shaders/radiant-shader",
  "version": "0.1.0",
  "title": "Radiant Shader",
  "category": "design",
  "icon": "art",
  "description": "Use Radiant shaders as animated block backgrounds with live parameter controls.",
  "textdomain": "wp-radiant-shaders",
  "supports": {
    "align": [
      "wide",
      "full"
    ],
    "dimensions": {
      "minHeight": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    },
    "anchor": true,
    "html": false
  },
  "attributes": {
    "shaderId": {
      "type": "string",
      "default": "flow-field"
    },
    "scheme": {
      "type": "string",
      "default": "amber"
    },
    "colorMode": {
      "type": "string",
      "default": "preset"
    },
    "themeColorSlug": {
      "type": "string",
      "default": ""
    },
    "themeColorValue": {
      "type": "string",
      "default": ""
    },
    "showShaderLabel": {
      "type": "boolean",
      "default": false
    },
    "invertTone": {
      "type": "boolean",
      "default": false
    },
    "shaderBlendMode": {
      "type": "string",
      "default": "normal"
    },
    "iframeProps": {
      "type": "object",
      "default": {}
    },
    "params": {
      "type": "object",
      "default": {}
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css"
}